<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Jackalope</PackageId>
    <Description>A lightweight, in-process or standalone mock RabbitMQ broker that speaks AMQP 0-9-1 well enough for the real RabbitMQ.Client to use it. One isolated instance per test run, no Docker required.</Description>
    <PackageTags>rabbitmq;amqp;amqp-0-9-1;testing;mock;fake;broker</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <InternalsVisibleTo Include="Jackalope.Tests" />
  </ItemGroup>

</Project>
